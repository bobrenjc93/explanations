+        # where they lie, the places of its own with the tensor each is
+        # copied from, and what it gives.
+        self.fixed: tuple[int, ...] = ()
+        self.where: tuple[int, ...] = ()
+        self.buffers: list[tuple[torch.Tensor, int]] = []
+        self.given: tuple[Any, ...] = ()
+        self.tensors: tuple[int, ...] = ()
+        # Of what it gives, what is handed out without a copy: which, how
+        # many references the memory of each has by itself, and the tensors
+        # the last run handed out.
