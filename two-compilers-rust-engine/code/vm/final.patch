+        # before it is started ahead.
+        self.streak = 0
+        self.needed = 0
+        # Times it was started ahead, for a call that came, and for nothing.
+        # And: tensors handed out that were copied later, and calls that
+        # found a view of one alive.
+        self.counts = [0, 0, 0, 0, 0]
+        # The tensors that are read in place, and those that the last call
+        # copied.
+        self.held: list[torch.Tensor] = []
+        self.places: Any = b""
+        self.last: dict[int, torch.Tensor] = {}
+        self.lock = threading.Lock()
+        self.graph: Any = None
+        self.records = 0
+        # Where the tensors lay in the call before the graph was taken down.
+        self.seen: tuple[int, ...] | None = None
+        # The tensors that are copied, once the graph was first taken down;
+        # and how many times each of the others was found somewhere else.
+        self.copied: set[int] | None = None
+        self.moves: dict[int, int] = {}
