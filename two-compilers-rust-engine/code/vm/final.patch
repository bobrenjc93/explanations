+++ b/torch/vm/_cudagraphs.py
@@ -0,0 +1,631 @@
+"""What a pass compiled for a graph on a GPU, run as one CUDA graph.
+
+What a compiler makes of a graph is a function that starts one kernel after
+the other, and on a GPU the time between two of them is the processor's. A
+CUDA graph is the kernels of one run of such a function, taken down with
+their arguments and started again as one. :class:`Replayed` stands in front
+of what was compiled and does that for the calls it can be shown right for;
+every other call runs what was compiled as it is.
+
+What a CUDA graph fixes is where its kernels read and write. So:
+
+- A tensor the graph is given is read where it lies. The tensors that lay at
+  the same place in two calls in a row (the weights of a model) are read
+  there, and every call checks that they still lie there; what they hold is
+  read when the kernels run, so a weight that was written in place is
+  followed. The other tensors are copied to a place of the graph's own in
+  front of it. When a tensor is found somewhere else (a parameter that was
+  replaced, a model that was moved and moved back), the graph is taken
+  down again and reads it where it lies now; one that is found somewhere
+  else a second time is copied from then on.
+- What the graph gives lies in memory of the graph that the next run writes
+  again, so a call gets copies of its own. Where that is asked for
+  (``hand_out``), a large tensor is not copied when it is handed out: it
+  is copied when the graph is about to run again and somebody still has
+  it, which its reference counts tell (those of the tensor, and of its
+  memory, which a view of it holds). The tensor that was handed out is
+  then given the copy as its memory. While a view of one is alive, which
+  cannot be given other memory, the graph does not run: what was compiled
+  does. What this cannot see is somebody who took the address of the
+  memory and kept it (a DLPack capsule, ``__cuda_array_interface__``):
+  for them the next run writes the tensor. That is given up, and so it is
+  only done when asked for.
+- The graph can be started in front of the checks that say whether a call
+  is one it was made for (``ahead``): its kernels then run while the checks
+  do. Until the call itself comes it has written to nothing but its own
+  memory, and a call that does not come (``missed``) leaves nothing behind.
+  For that the tensors it reads in place are kept, so that the memory it
+  reads is there whatever became of them. A graph that draws random numbers
+  is not started ahead: the numbers of a run that is dropped would be
+  missing.
+- The weights of convolutions can be handed to what was compiled laid
+  out as the kernels want them (channels last), so that they are not
+  copied into that layout by every run (``channels_last_weights``). A
+  weight of a convolution over single elements (1x1) lies in memory the same
+  way in both layouts, so the graph is given a view of it: that is always
+  right. For the others a copy is kept and made again when the weight is
+  another tensor or its version counter has moved. That follows every
+  write that autograd would see (``w.add_()``, ``w.copy_()``, a write
+  through a view or through ``w.detach()``); it does not follow a write
+  that moves no counter: one through ``w.data``, or by another library.
+  That is given up, and so it is only done when asked for.
+- Nothing that the function does on the processor runs again: the function
+  must do the same there in every call. The calls of one form of a graph
+  have tensors of the same sizes, and what was compiled has no branches.
+  A graph that makes a tensor on the processor from anything but numbers,
+  that writes to what it is given, that gives back what it is given or two
+  views of one tensor, or whose tensors require a gradient, runs as it is.
+"""
+
+import copy as _copy
+import os
+import sys
+import threading
+from collections.abc import Callable
+from typing import Any
+
+import torch
+
+from . import _types
+
+
+_PTR = torch.Tensor.data_ptr
+
+
+def _places(tensors: list[torch.Tensor]) -> Any:
+    """Where the memory of some tensors lies, for `_lie_at`: asked of the
+    engine in one call, which is what a call that starts ahead waits for."""
+    from torch import _cfg_rs
+
+    return _cfg_rs.places(tensors)
+
+
+def _lie_at(tensors: list[torch.Tensor], places: Any) -> bool:
+    from torch import _cfg_rs
+
+    return _cfg_rs.lie_at(tensors, places)
+
+# The functions that make a tensor from numbers alone: what such a call gives
+# on the processor is the same in every run.
+_FROM_NUMBERS = frozenset(
+    {"tensor", "as_tensor", "arange", "zeros", "ones", "full", "linspace", "eye"}
+)
+# How many times a graph is taken down again because a tensor it read in
+# place lay somewhere else, before its calls run what was compiled as it is.
+_RECORDS = 6
+
+
+# A graph that was started ahead for nothing is started ahead again once
+# this many calls in a row have run it: twice as many with each time it was
+# for nothing, up to _WAIT, and half as many again with every _SURE calls in
+# a row that it was started ahead for.
+_WAIT = 32
+_SURE = 64
+# From how many bytes on a tensor that a graph gives is handed out without
+# a copy, and copied only if it is still held when the graph runs again.
+_LARGE = 1 << 20
+
+
+def _numbers(value: Any) -> bool:
+    if isinstance(value, (list, tuple)):
+        return all(_numbers(item) for item in value)
+    return not isinstance(value, (torch.fx.Node, torch.Tensor))
+
+
+def unfit(gm: torch.fx.GraphModule) -> str:
+    """Why the graph a pass was given cannot run as a CUDA graph, as far as
+    its nodes say; empty if nothing stands against it. A tensor that the
+    graph computes on the processor is computed once, when the kernels are
+    taken down: that is right only for one made from numbers."""
+    for node in gm.graph.nodes:
+        if node.op not in ("call_function", "call_method"):
+            continue
+        tags = getattr(node.target, "tags", ())
+        if torch.Tag.dynamic_output_shape in tags or torch.Tag.data_dependent_output in tags:
+            return f"{node.target} looks into a tensor"
+        found = node.meta.get(_types._TYPE)
+        if found is None or found.device.type == "cuda":
+            continue
+        name = getattr(node.target, "__name__", "")
+        constant = _numbers(node.args) and _numbers(tuple(node.kwargs.values()))
+        if not (constant and name in _FROM_NUMBERS):
+            return f"{node.name} is computed on {found.device}"
+    return ""
+
+
+def channels_last_weights(
+    gm: torch.fx.GraphModule, examples: list[torch.Tensor], keep: bool
+) -> tuple[torch.fx.GraphModule, list[tuple[int, bool]]] | None:
+    """A copy of the graph in which the convolutions take their weights from
+    further inputs, behind those of the graph: per weight one that is laid
+    out channels last. Returns it with, per such input, the input it is the
+    weight of and whether it is a view of it (a 1x1 weight) or a copy that
+    is kept (the others, only with ``keep``). None if the graph is not one
+    of plain 2-d convolutions whose weights are inputs, laid out densely:
+    what Inductor lays out channels last by itself."""
+    placeholders = [node for node in gm.graph.nodes if node.op == "placeholder"]
+    index = {node: k for k, node in enumerate(placeholders)}
+    convolutions = (torch.ops.aten.conv2d.default, torch.conv2d)
+    found = []
+    for node in gm.graph.nodes:
+        if node.op != "call_function" or node.target not in convolutions:
+            continue
+        weight = node.args[1] if len(node.args) > 1 else node.kwargs.get("weight")
+        groups = node.args[6] if len(node.args) > 6 else node.kwargs.get("groups", 1)
