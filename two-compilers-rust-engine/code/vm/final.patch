+@dataclasses.dataclass(frozen=True, repr=False)
+class SplitPools(BuiltinPass):
+    """A pass over a graph: a max pool over a window of ``min_window``
+    elements or more becomes two, one along each dimension of the window.
+
+    The largest value of a window is the largest of the largest values of
+    its rows, so the result is the same, bit for bit, padding, stride and
+    dilation included; a compiler that reads a whole window per element
+    reads ``k + k`` values for it instead of ``k * k``. It looks at calls of
+    ``torch.max_pool2d`` that do not round sizes up (``ceil_mode``). It
+    stands between :class:`Graphs` and the pass that compiles.
+    """
+
+    engine: ClassVar[str] = "split_pools"
+    kind: ClassVar[str] = "graph"
+
+    min_window: int = 16
+
+    def __call__(self, gm: Any, input_types: list[Any]) -> Any:
+        import torch
+
+        def pair(value: Any) -> Any:
+            if isinstance(value, int) and not isinstance(value, bool):
+                return (value, value)
+            fits = isinstance(value, (tuple, list)) and all(type(n) is int for n in value)
+            if fits and len(value) == 1:
+                return (value[0], value[0])
+            return tuple(value) if fits and len(value) == 2 else None
+
+        pools = (torch.max_pool2d, torch.ops.aten.max_pool2d.default)
+        names = ("input", "kernel_size", "stride", "padding", "dilation", "ceil_mode")
+        for node in list(gm.graph.nodes):
+            if node.op != "call_function" or node.target not in pools:
+                continue
+            given = dict(zip(names, node.args))
+            if len(node.args) > len(names) or set(node.kwargs) - set(names) or set(node.kwargs) & set(given):
+                continue
+            given.update(node.kwargs)
+            if "input" not in given or "kernel_size" not in given or given.get("ceil_mode", False) is not False:
+                continue
+            window = pair(given["kernel_size"])
+            stride = given.get("stride")
+            # Without a stride the window moves on by its own size.
+            stride = window if stride is None or stride == [] or stride == () else pair(stride)
+            padding, dilation = pair(given.get("padding", 0)), pair(given.get("dilation", 1))
+            if None in (window, stride, padding, dilation):
+                continue
+            if window[0] < 2 or window[1] < 2 or window[0] * window[1] < self.min_window:
+                continue
+            with gm.graph.inserting_before(node):
+                across = gm.graph.call_function(
+                    node.target,
+                    (given["input"], (1, window[1]), (1, stride[1]), (0, padding[1]), (1, dilation[1]), False),
+                )
+                down = gm.graph.call_function(
+                    node.target,
+                    (across, (window[0], 1), (stride[0], 1), (padding[0], 0), (dilation[0], 1), False),
+                )
+            across.meta, down.meta = {}, dict(node.meta)
+            node.replace_all_uses_with(down)
+            gm.graph.erase_node(node)
+        gm.recompile()
+        return gm
