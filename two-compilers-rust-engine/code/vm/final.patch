+/// Where the memory of each tensor of a list lies, as native words in a
+/// bytes object (zero for what is no tensor): what `lie_at` is asked with
+/// later.
+#[pyfunction]
+pub fn places<'py>(py: Python<'py>, tensors: &Bound<'py, PyList>) -> PyResult<Bound<'py, PyBytes>> {
+    let api = capi::api().ok_or_else(|| PyRuntimeError::new_err("torch.vm is not initialized"))?;
+    let list = tensors.as_ptr();
+    let mut found: Vec<u8> = Vec::new();
+    unsafe {
+        for i in 0..ffi::PyList_GET_SIZE(list) {
+            let mut info = capi::TcfgTensorInfo::empty();
+            let tensor = (api.tensor_info)(ffi::PyList_GET_ITEM(list, i), &mut info) != 0;
+            let at = if tensor { info.data as usize } else { 0 };
+            found.extend_from_slice(&at.to_ne_bytes());
+        }
+    }
+    Ok(PyBytes::new(py, &found))
+}
+
+/// Whether the tensors of a list lie where `places` found them, or others
+/// like them.
+#[pyfunction]
+pub fn lie_at(tensors: &Bound<'_, PyList>, places: &Bound<'_, PyBytes>) -> bool {
+    let Some(api) = capi::api() else {
+        return false;
+    };
+    let (list, expected) = (tensors.as_ptr(), places.as_bytes());
+    let word = std::mem::size_of::<usize>();
+    unsafe {
+        let count = ffi::PyList_GET_SIZE(list) as usize;
+        if expected.len() != count * word {
+            return false;
+        }
+        for i in 0..count {
+            let mut info = capi::TcfgTensorInfo::empty();
+            let tensor = (api.tensor_info)(ffi::PyList_GET_ITEM(list, i as isize), &mut info) != 0;
+            let at = if tensor { info.data as usize } else { 0 };
+            if at.to_ne_bytes() != expected[i * word..(i + 1) * word] {
+                return false;
+            }
+        }
+    }
+    true
+}
