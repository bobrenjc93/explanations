+def _max_pool_indices_unused() -> bool:
+    """Whether nothing reads output 1 (indices or offsets) of the max pool node being lowered."""
+    node = V.graph.current_node
+    if node is None or len(node.users) == 0:
+        return False
+    return all(
+        user.op == "call_function"
+        and user.target is operator.getitem
+        and user.args[1] == 0
+        for user in node.users
+    )
+
+
+def _should_separate_max_pool(kernel_size, stride) -> bool:
+    """
+    A max over a window is the max over one dimension of the maxima over the
+    others, so the pool can run as one 1-d pass per dimension: sum(k) loads
+    per output instead of prod(k). The earlier passes run at the resolution
+    the later dimensions still have before their stride, and each pass adds
+    a kernel, so this is only taken when it at least halves the loads.
+    """
+    if not all(isinstance(v, int) for v in (*kernel_size, *stride)):
+        return False
+    pooled = [d for d in range(len(kernel_size)) if kernel_size[d] > 1]
+    if len(pooled) < 2:
+        return False
+    direct = functools.reduce(operator.mul, kernel_size)
+    separate = 0
+    # passes run from the last dimension to the first
+    for i, d in enumerate(pooled):
+        separate += kernel_size[d] * functools.reduce(
+            operator.mul, [stride[e] for e in pooled[:i]], 1
+        )
+    return 2 * separate <= direct
+
+
+def _separable_max_pool(x, kernel_size, stride, padding, dilation, ceil_mode, *, n_dim):
+    out = x
+    # Each pass is a short 1-d reduction: unroll it into a pointwise kernel, as
+    # the low-memory path does for its windows of up to 25 elements.
+    with config.patch(
+        unroll_reductions_threshold=max(config.unroll_reductions_threshold, 25)
+    ):
+        for d in reversed(range(n_dim)):
+            if kernel_size[d] == 1 and stride[d] == 1 and padding[d] == 0:
+                continue
+            one = [1] * n_dim
+            zero = [0] * n_dim
+            out, _ = _max_pool_with_offsets(
+                out,
+                [*one[:d], kernel_size[d], *one[d + 1 :]],
+                [*one[:d], stride[d], *one[d + 1 :]],
+                [*zero[:d], padding[d], *zero[d + 1 :]],
+                [*one[:d], dilation[d], *one[d + 1 :]],
+                ceil_mode,
+                n_dim=n_dim,
+                with_offsets=False,
+            )
+    return out
+
+
