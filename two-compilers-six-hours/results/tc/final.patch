+    @unsupported_guard_check_spec
+    def FROZEN_TENSOR_VERSION(self, guard: Guard) -> None:
+        """Inductor freezing read this tensor's values at compile time, so an
+        in-place update (which bumps the version counter) has to recompile. A
+        tensor the graph did not freeze (it is unused, or the graph itself
+        writes it and keeps it as an input) needs no such guard. Writes through
+        `.data` have their own version counter and stay invisible, as they are
+        to autograd."""
