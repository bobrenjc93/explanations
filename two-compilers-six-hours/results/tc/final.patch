+            )
+        frozen = None if tracing_context is None else tracing_context.frozen_params
+        # Without the record of what was frozen, guard every candidate
+        if frozen is not None and not any(value is p for p in frozen):
+            return
+        self._guard_on_attribute(guard, "_version", GuardBuilder.EQUALS_MATCH)
+
