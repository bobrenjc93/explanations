+class _Replay:
+    """What a backend made of a graph, run as a CUDA graph.
+
+    On a GPU a call of a compiled graph is a few hundred kernel launches, and
+    for a model of small layers the CPU takes longer to make them than the
+    GPU to run them. A CUDA graph is the launches of one call, recorded:
+    replaying it starts them all at once. It is the same kernels on the same
+    memory every time, so the inputs of a call are copied to where the
+    recorded call had its inputs, and the results are copies of what the
+    recorded call left where it had its results: every call gets tensors of
+    its own, as it does from the code itself. A caller that hands over the
+    same memory again and again (one buffer it fills, a few it goes round)
+    gets a recording that reads the inputs where they are, and no copy.
+
+    The code itself runs the first call (kernels are chosen and loaded then),
+    and the second, which is then recorded and replayed once: unless the
+    replay gives what the code gave, bit for bit, on the same tensors, in the
+    same layout, and neither wrote to an input nor gave back memory of an
+    input or one result in the memory of another, the code goes on running
+    every call. So it does when gradients are recorded, under a torch
+    function or dispatch mode, while the caller is recording a CUDA graph of
+    its own, and while another thread is replaying.
+    ``_replayable`` says what a graph has to be like before any of this.
+    """
+
+    __slots__ = (
+        "calls",
+        "compiled",
+        "constant",
+        "device",
+        "inplace",
+        "lock",
+        "off",
+        "recordings",
+        "seen",
+        "used",
+    )
+
+    def __init__(
+        self,
+        compiled: Callable[..., Any],
+        used: list[int],
+        constant: list[bool],
+        device: torch.device | None,
+        off: str | None,
+    ) -> None:
+        self.compiled = compiled
+        self.used = used
+        self.constant = constant
+        self.device = device
+        # Why the code runs every call, once that is known.
+        self.off = off
+        self.calls = 0
+        # By whether the call is under inference mode, whose tensors are
+        # not those of other calls: the CUDA graph, where its inputs are
+        # (with their place among those of a call), and where its results.
+        self.recordings: dict[bool, tuple[Any, list[Any], list[torch.Tensor]]] = {}
+        # Recordings that read the inputs where a call had them, by where
+        # that was (see ``place``), and how often a place was seen.
+        self.inplace: dict[Any, tuple[Any, list[Any], list[torch.Tensor]]] = {}
+        self.seen: dict[Any, int] = {}
+        self.lock = threading.Lock()
