+# How many recordings a graph may have that read their inputs in the memory
+# a call had them in, and at which sighting of such memory one is made.
+_MOST_PLACES = 4
+_PLACE_SEEN = 3
+
+
+def _devices_of(value: Any) -> set[torch.device] | None:
+    """The devices of the tensors a node of a graph stands for; None if it
+    stands for something else than tensors and plain values, or for a tensor
+    whose size is a symbol."""
+    if isinstance(value, torch.Tensor):
+        if any(type(size) is not int for size in value.shape):
+            return None
+        return {value.device}
+    if type(value) in (tuple, list):
+        found: set[torch.device] = set()
+        for item in value:
+            inner = _devices_of(item)
+            if inner is None:
+                return None
+            found |= inner
+        return found
+    return set() if type(value) in _VALUES else None
+
+
+def _replayable(
+    graph: torch.fx.GraphModule,
+) -> tuple[list[int], list[bool], torch.device]:
+    """Whether the kernels of a graph are the same kernels on the same memory
+    at every call, so that a CUDA graph of one call is every call
+    (``_Replay``). Returns which inputs the graph reads, which of its results
+    do not depend on an input, and the GPU; raises ``_NoReplay`` otherwise.
+
+    A CUDA graph holds the work of one GPU and nothing else. So everything
+    that depends on an input has to be on that GPU; what is computed on the
+    CPU has to follow from constants alone, which makes it what it was when
+    the graph was recorded; no operation takes tensors of two devices (a
+    copy from the host would be replayed from memory that may be gone); and
+    there is neither a size that is a symbol, nor an operation whose kernels
+    depend on what a tensor holds, nor one that draws random numbers.
+    """
+    from torch._inductor.utils import get_first_incompatible_cudagraph_node
+
+    values: dict[torch.fx.Node, set[torch.device]] = {}
+    moving: set[torch.fx.Node] = set()
+    gpus: set[torch.device] = set()
+    placeholders = []
+    results: Any = None
+    for node in graph.graph.nodes:
+        if node.op == "output":
+            results = node.args[0]
+            continue
+        if node.op == "get_attr":
+            try:
+                held: Any = operator.attrgetter(node.target)(graph)
+            except AttributeError:
+                held = None
+            devices = _devices_of(held) if isinstance(held, torch.Tensor) else None
+        else:
+            devices = _devices_of(node.meta.get("val", node))
+        if devices is None:
+            raise _NoReplay(f"{node.name} is no tensor of a known size")
+        values[node] = devices
+        if node.op == "placeholder":
+            placeholders.append(node)
+            moving.add(node)
+            if node.users:
+                gpus |= devices
+            continue
+        if getattr(node.target, "_nondeterministic_seeded", False):
+            # Recording and the replay that checks it would each draw from
+            # the generator, and leave it further on than one call does.
+            raise _NoReplay(f"{node.name} draws random numbers")
+        given = node.all_input_nodes
+        touched = set(devices).union(*[values[n] for n in given])
+        constant = node.op == "get_attr" or (
+            node.op == "call_function"
+            and not node.is_impure(True)
+            and not any(n in moving for n in given)
+        )
+        if not constant:
+            moving.add(node)
+        if len(touched) > 1:
+            raise _NoReplay(f"{node.name} takes tensors of more than one device")
+        if any(device.type != "cuda" for device in touched):
+            if not constant:
+                raise _NoReplay(f"{node.name} is work of the CPU")
+        else:
+            gpus |= touched
+    if len(gpus) != 1 or next(iter(gpus)).type != "cuda":
+        raise _NoReplay("not the work of one GPU")
+    unsafe = get_first_incompatible_cudagraph_node(graph)
+    if unsafe is not None:
+        raise _NoReplay(f"{unsafe.name} cannot be part of a CUDA graph")
+    if type(results) not in (tuple, list) or not all(
+        isinstance(result, torch.fx.Node) for result in results
+    ):
+        raise _NoReplay("gives something else than tensors")
+    used = [i for i, node in enumerate(placeholders) if node.users]
+    return used, [result not in moving for result in results], next(iter(gpus))
+
