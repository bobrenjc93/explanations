+def _half_conv_in_channel_padding(
+    x: TensorBox,
+    in_chan: int,
+    groups: int,
+    transposed: bool,
+    ndim: int,
+    device_type: str,
+) -> int:
+    """Number of zero input channels to add to a convolution.
+
+    cuDNN's channels-last half-precision kernels are slow for 3 input channels
+    (the first convolution of an image model): 102 us with 3 channels against
+    78 us with a 4th channel of zeros (bf16 and fp16, 8x3x384x512 to 32
+    channels, 3x3, H100). A zero channel with zero weights adds exactly 0 to
+    every sum, so only the kernel cuDNN picks changes.
+    """
+    if (
+        device_type == "cuda"
+        and V.graph.layout_opt
+        and ndim == 2
+        and not transposed
+        and groups == 1
+        and in_chan == 3
+        and x.get_dtype() in (torch.float16, torch.bfloat16)
+        and V.graph.sizevars.statically_known_equals(x.get_size()[1], in_chan)
+    ):
+        return 1
+    return 0
+
+
+def _pad_weight_in_channels(weight: TensorBox, pads: list[int]) -> TensorBox:
+    data = weight.data
+    name = (
+        data.data.get_name()
+        if isinstance(data, ir.StorageBox) and isinstance(data.data, ir.ConstantBuffer)
+        else None
+    )
+    if (
+        name is not None
+        and name in V.graph.constants
+        and data.data.override_device is None
+    ):
+        # A constant weight (freezing) is padded once, at compile time
+        with no_dispatch():
+            padded = torch.nn.functional.pad(V.graph.constants[name], pads)
+            padded = padded.contiguous(memory_format=torch.channels_last)
+        return V.graph.add_tensor_constant(padded)
+    return L[aten.constant_pad_nd](weight, pads, 0)
+
