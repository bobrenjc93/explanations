+def _cur_node_uses_only_values() -> bool:
+    """True when the FX node being lowered returns (values, indices) and nothing reads the indices."""
+    node = getattr(V.graph, "current_node", None)
+    if node is None:
+        return False
+    return all(
+        user.op == "call_function"
+        and user.target is operator.getitem
+        and user.args[1] == 0
+        for user in node.users
+    )
+
+
+def _max_pool_separable_pays_off(kernel_size, stride) -> bool:
+    """The max over a window is the max over one dim of the max over the others, so the
+    values can be reduced one dim at a time: k_1 + ... + k_n loads per element in place
+    of k_1 * ... * k_n. Dims are reduced last to first, so the intermediate of dim d
+    still has dims before d at input resolution (stride times more elements), and each
+    intermediate is stored and loaded again. Only worth it when it at least halves the loads.
+    """
+    if not all(isinstance(v, (int, sympy.Integer)) for v in (*kernel_size, *stride)):
+        return False
+    if sum(k > 1 for k in kernel_size) < 2:
+        return False
+    window = functools.reduce(operator.mul, kernel_size)
+    loads, scale = 0, 1
+    for d in range(len(kernel_size)):
+        # +2: the store and the load of the intermediate (the last stage, dim 0, has none)
+        loads += (kernel_size[d] + (2 if d > 0 else 0)) * scale
+        scale *= stride[d]
+    return 2 * loads <= window
+
+
+def _max_pool_values_separable(
+    x, kernel_size, stride, padding, dilation, dhw_out, min_value, check_bounds, n_dim
+):
+    dtype = x.dtype
+    cur = x
+    for d in reversed(range(n_dim)):
+        size = list(cur.get_size())
+        axis = len(size) - n_dim + d
+        in_size = size[axis]
+        size[axis] = dhw_out[d]
+        loader = cur.make_loader()
+
+        def fn_inner(idx, reduction_idx, loader=loader, axis=axis, d=d, in_size=in_size):
+            pos = idx[axis] * stride[d] + reduction_idx[0] * dilation[d] - padding[d]
+            index = [*idx[:axis], pos, *idx[axis + 1 :]]
+            if not check_bounds:
+                return loader(index)
+            return ops.masked(
+                range_mask(pos, in_size, 0), lambda: loader(index), min_value
+            )
+
+        # One dim of a pooling window is short: a pointwise kernel of k loads beats a
+        # reduction kernel over k elements, as on the low-memory path.
+        with config.patch(
+            unroll_reductions_threshold=max(config.unroll_reductions_threshold, 26)
+        ):
+            cur = Reduction.create(
+                reduction_type="max",
+                input_node=cur,
+                device=x.get_device(),
+                dst_dtype=dtype,
+                src_dtype=dtype,
+                inner_fn=fn_inner,
+                ranges=size,
+                reduction_ranges=[kernel_size[d]],
+            )
+        if d > 0:
+            # An unrealized stage would be inlined into the next one, window loads again
+            cur.realize()
+    return cur
+
